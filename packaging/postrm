#!/bin/sh
set -eu

case "$1" in
    remove)
        if command -v deb-systemd-helper >/dev/null; then
            deb-systemd-helper mask rpi-web-control.service >/dev/null
            deb-systemd-helper mask rpi-web-control-recovery.timer >/dev/null
        fi
        ;;
    purge)
        if command -v deb-systemd-helper >/dev/null; then
            deb-systemd-helper purge rpi-web-control.service >/dev/null
            deb-systemd-helper unmask rpi-web-control.service >/dev/null
            deb-systemd-helper purge rpi-web-control-recovery.timer >/dev/null
            deb-systemd-helper unmask rpi-web-control-recovery.timer >/dev/null
        fi
        # Preserve recordings, operator configuration and the service UID.
        rm -f /etc/rpi-web-control/token /etc/rpi-web-control/tls.crt /etc/rpi-web-control/tls.key
        rmdir /etc/rpi-web-control 2>/dev/null || true
        ;;
esac
if [ -d /run/systemd/system ] && { [ "$1" = remove ] || [ "$1" = purge ]; }; then
    systemctl --system daemon-reload
fi
exit 0
