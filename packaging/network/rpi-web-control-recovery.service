[Unit]
Description=Maintain the wired recovery address for Raspberry Pi
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/lib/rpi-web-control/recovery-helper.py reconcile
EnvironmentFile=-/etc/default/rpi-web-control
RuntimeDirectory=rpi-web-control-recovery
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
LogLevelMax=notice
SyslogLevel=warning
TimeoutStartSec=40
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_PACKET AF_INET
